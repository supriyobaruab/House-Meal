<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculate</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="w-screen h-screen">
    <div
      class="flex flex-col justify-center items-center w-full h-full hidden"
      id="load"
    >
      <div
        class="w-28 h-28 sm:w-32 sm:h-32 rounded-full border-10 border-gray-50 border-t-blue-700 animate-spin"
      ></div>
      <div class="p-4">
        <p class="text-2xl">Calculating</p>
      </div>
    </div>
    <!-- Summary cost -->
    <div class="flex justify-center items-center w-full h-full">
      <div class="p-8 w-106 h-96 bg-gray-100 rounded-xl box-shadow">
        <p class="text-center text-2xl">Meal Summary</p>
        <table class="border-1">
          <tr>
            <td>Name</td>
            <td>Contribution</td>
            <td>Test</td>
          </tr>
        </table>
      </div>
    </div>
    <script src="./calculate.js"></script>
  </body>
</html>
