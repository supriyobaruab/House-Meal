<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculate</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="w-screen h-screen">
    <div
      class="flex flex-col justify-center items-center w-full h-full hidden"
      id="load"
    >
      <div
        class="w-28 h-28 sm:w-32 sm:h-32 rounded-full border-10 border-gray-50 border-t-blue-700 animate-spin"
      ></div>
      <div class="p-4">
        <p class="text-2xl">Calculating</p>
      </div>
    </div>
    <!-- Summary cost -->
    <div
      class="flex flex-col sm:justify-center sm:items-center w-full h-full hidden"
      id="summary"
    >
      <div class="p-6">
        <p class="text-center text-2xl font-bold">COST SUMMARY</p>
      </div>
      <div
        class="w-96 sm:w-106 h-64 bg-gray-50 rounded-xl shadow-md hover:shadow-lg duration-500"
      >
        <div class="p-8 w-full h-full flex flex-col justify-center">
          <table class="border border-2 over-flow-hidden">
            <caption></caption>
            <thead>
              <tr class="border">
                <th>Name</th>
                <th>Contribution</th>
                <th>Total Cost</th>
              </tr>
            </thead>
            <tbody id="table-body"></tbody>
          </table>
        </div>
      </div>
    </div>
    <script src="./calculate.js"></script>
  </body>
</html>
