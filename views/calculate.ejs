<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculate</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="h-screen">
    <div
      class="flex flex-col justify-center items-center w-screen h-screen hidden"
      id="load"
    >
      <div
        class="w-28 h-28 sm:w-32 sm:h-32 rounded-full border-10 border-gray-50 border-t-blue-700 animate-spin"
      ></div>
      <div class="p-4">
        <p class="text-2xl">Calculating</p>
      </div>
    </div>
    <div
      class="flex justify-center items-center w-screen h-screen hidden"
      id="summary"
    >
      <div class="grid grid-cols-2 gap-10">
        <div
          class="w-106 h-64 bg-gray-50 rounded-xl hover:shadow-md duration-500"
        ></div>
        <div class="w-106 h-64 bg-gray-50 rounded-xl"></div>
        <div class="w-106 h-64 bg-gray-50 rounded-xl"></div>
        <div class="w-106 h-64 bg-gray-50 rounded-xl"></div>
      </div>
    </div>
    <script src="./calculate.js"></script>
  </body>
</html>
