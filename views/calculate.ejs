<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculate</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="h-screen">
    <div
      class="flex flex-col justify-center items-center w-screen h-screen hidden"
      id="load"
    >
      <div
        class="w-28 h-28 sm:w-32 sm:h-32 rounded-full border-10 border-gray-50 border-t-blue-700 animate-spin"
      ></div>
      <div class="p-4">
        <p class="text-2xl">Calculating</p>
      </div>
    </div>
    <div
      class="flex justify-center items-center w-screen h-screen hidden"
      id="summary"
    >
      <div
        class="p-10 bg-gray-100 w-[85%] h-[70%] sm:w-[50%] sm:h-[50%] rounded-xl shadow-xl"
      >
        <div class="flex flex-col gap-4">
          <p class="text-3xl text-center">MEAL COST OVERVIEW</p>
          <p class="text-xl">TOTAL MEAL TAKEN</p>
          <p class="text-xl">MEAL RATE</p>
          <p class="text-l">SUPRIYO</p>
          <p class="text-l">DEBONGSHI</p>
          <p class="text-l">WALY VAI</p>
          <p class="text-l">MAHMUD VAI</p>
        </div>
      </div>
    </div>
    <script src="./calculate.js"></script>
  </body>
</html>
