<div class="bg-white h-94 w-full rounded-xl my-4 p-8">
  <p class="text-2xl pb-2 font-bold">Contribution</p>
  <div class="flex flex-col gap-2">
    <div class="flex gap-6 py-4 justify-between">
      <select
        name="persons"
        id="person"
        class="p-2 border border-1 border-gray-300 h-10 rounded-sm w-[130px] shadow-md"
      >
        <option value="supriyo">Supriyo</option>
        <option value="debongshi">Debongshi</option>
        <option value="waly">Waly vai</option>
        <option value="mahmud">Mahmud vai</option>
      </select>
      <input
        class="p-4 border border-1 border-gray-300 h-10 rounded-sm w-32"
        type="number"
        placeholder="৳ Amount"
        id="input"
      />
    </div>
    <div class="flex flex-row gap-6">
      <textarea
        class="p-4 border border-1 border-gray-300 h-32 rounded-sm w-full resize-none align-top"
        placeholder="Description"
        id="description"
      ></textarea>
    </div>
    <div class="pt-4">
      <button
        class="bg-green-700 hover:bg-white border border-green-700 w-full h-10 rounded-[4px] text-white text-[14px] hover:text-black transition duration-500"
        id="ctbe"
      >
        Contribute
      </button>
    </div>
  </div>
</div>
