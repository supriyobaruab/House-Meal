<div class="bg-white w-full rounded-xl my-4 p-8 pt-10">
  <div class="flex flex-row justify-between">
    <div class="h-full flex flex-col gap-1">
      <p>Total Meals Taken :</p>
    </div>
    <div class="h-full flex flex-col gap-1">
      <p id="total_meal">0</p>
    </div>
  </div>

  <hr class="h-px w-full my-4 border border-gray-300" />

  <div class="flex flex-row justify-between">
    <div class="h-full flex flex-col gap-1">
      <p>Total Contribution :</p>
    </div>
    <div class="h-full flex flex-col gap-1">
      <p id="total_contribution">৳0</p>
    </div>
  </div>

  <hr class="h-px w-full my-4 border border-gray-300" />

  <div class="flex flex-row justify-between">
    <div class="h-full flex flex-col gap-1">
      <p class="text-md text-blue-700 font-bold">Meal Rate :</p>
    </div>
    <div class="h-full flex flex-col gap-1">
      <p class="text-md text-blue-700 font-bold" id="rate">৳0/Meal</p>
    </div>
  </div>
  <div class="pt-4 flex justify-between">
    <button
      onclick="window.location.href='/calculate'"
      class="bg-blue-700 hover:bg-white border border-blue-700 w-[30%] h-10 rounded-[4px] text-white text-[14px] hover:text-black transition duration-500"
    >
      Calculate
    </button>
    <button
      class="bg-red-700 hover:bg-white border border-red-700 w-[30%] h-10 rounded-[4px] text-white text-[14px] hover:text-black transition duration-500"
    >
      Reset
    </button>
  </div>
</div>
